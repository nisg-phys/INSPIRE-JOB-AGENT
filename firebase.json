{
  "hosting": {
    "public": "frontend",
    "rewrites": [
      {
        "source": "/jobs/**",
        "run": {
          "serviceId": "pulsar-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "/docs",
        "run": {
          "serviceId": "pulsar-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "/openapi.json",
        "run": {
          "serviceId": "pulsar-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      }
    ]
  }
}
