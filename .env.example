# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inspire_jobs

# LLM (Groq - https://console.groq.com)
GROQ_API_KEY=

# Embeddings (OpenAI text-embedding-3-small) - also used for query rewriting
# if LLM_PROVIDER=openai below.
OPENAI_API_KEY=

# Which LLM provider query_rewriter uses: "groq" (default) or "openai".
# LLM_PROVIDER=groq
